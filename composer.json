{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simurg/laravel",
    "description": "Laravel SDK that syncs scheduled tasks as monitors and reports their runs.",
    "type": "library",
    "keywords": [
        "laravel",
        "scheduler",
        "monitoring"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12 || ^11.3",
        "pestphp/pest": "^4.7 || ^5.3"
    },
    "autoload": {
        "psr-4": {
            "Simurg\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simurg\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simurg\\Laravel\\SimurgServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
